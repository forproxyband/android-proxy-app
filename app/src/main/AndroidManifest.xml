<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Wi-Fi link characteristics (speed / frequency / standard) for the
         Wi-Fi return widget. Normal permission, no runtime prompt. SSID is
         NOT read so we don't need ACCESS_FINE_LOCATION / NEARBY_WIFI_DEVICES. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- CRITICAL for Wi-Fi return: ConnectivityManager.requestNetwork()
         throws SecurityException without this permission on every Android
         version. Without it, the relay can't acquire a Wi-Fi Network for
         bindSocket, can't acquire a cellular Network for bindProcessToNetwork,
         and the split-routing self-test's WIFI/CELL probes both fail —
         making the whole feature silently leak traffic through Wi-Fi.
         Normal protection level, auto-granted at install, no runtime prompt.
         Versions < 1.0.56 missed this declaration; the symptom in the log
         was "requestNetwork(Wi-Fi) failed: was not granted either of these
         permissions: CHANGE_NETWORK_STATE, WRITE_SETTINGS". -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Granted via one-time `adb shell pm grant <pkg> WRITE_SECURE_SETTINGS`.
         Used by the IP-cycle button to flip Settings.Global.AIRPLANE_MODE_ON
         without root. Suppressed lint warning: required by design. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- QR code scanning for modem-tunnel config import. Camera is opened
         by the embedded ZXing CaptureActivity; runtime permission is
         requested by the library on first use. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- OTA self-update: hands the downloaded+decrypted APK to the system
         package installer. On API 26+ the user must additionally grant
         "install unknown apps" for this app (handled at runtime via
         PackageManager.canRequestPackageInstalls + ACTION_MANAGE_UNKNOWN_APP_SOURCES).
         See com.proxyagent.app.ota.ApkInstaller. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.AndroidProxyApp"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Hint to Play Store to pre-download the ML Kit code-scanner module
             after install, so first scan doesn't have to wait for a download. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AnalyticsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- OTA updates screen: channel picker + per-version install/downgrade.
             Reached from the update widget on the main screen. -->
        <activity
            android:name=".ota.UpdatesActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Portrait-locked CaptureActivity for ZXing embedded scanner.
             Default CaptureActivity is sensorLandscape; on portrait phones it
             shows the "rotate device" overlay instead of the camera preview.
             configChanges keeps the camera preview alive if the user rotates
             mid-scan — without it the activity restarts and the user sees a
             black flash. -->
        <activity
            android:name=".PortraitCaptureActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:theme="@style/zxing_CaptureTheme"
            android:windowSoftInputMode="stateAlwaysHidden"
            tools:ignore="LockedOrientationActivity" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <service
            android:name=".ProxyService"
            android:exported="false"
            android:process=":proxy"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Proxy agent maintains a persistent WebSocket to the registrator pool" />
        </service>

        <!-- Auto-restart the proxy service after an app upgrade. Fires only
             when this app's package is replaced — a directed self-broadcast,
             no data filter needed. The receiver gates on a "was_running"
             flag so users who'd manually stopped the agent before the
             update don't get the session resurrected. See
             PackageReplacedReceiver.kt for the full reasoning + OEM
             caveats. Runs in the default process (:main) since the receiver
             only needs SharedPreferences and startForegroundService — no
             reason to drag :proxy in for a one-shot dispatch. -->
        <receiver
            android:name=".PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
