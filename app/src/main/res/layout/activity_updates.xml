<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e"
    android:padding="20dp"
    android:fitsSystemWindows="true">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UPDATES"
        android:textColor="#e94560"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:id="@+id/tvInstalled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#888888"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CHANNEL"
        android:textColor="#e94560"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spChannel"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="#16213e"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#88ffaa"
        android:textSize="14sp"
        android:textStyle="bold"
        android:padding="10dp"
        android:background="#16213e"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvLastCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#888888"
        android:textSize="11sp"
        android:layout_marginBottom="14dp" />

    <!-- Primary action: install the selected channel's actual (current) version. -->
    <Button
        android:id="@+id/btnInstall"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="INSTALL"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#e94560"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnCheck"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="CHECK FOR UPDATES"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#e94560"
        android:backgroundTint="#16213e"
        android:layout_marginBottom="8dp" />

    <!-- Reveals the older-versions list for manual downgrade (save-to-Downloads). -->
    <Button
        android:id="@+id/btnDowngrade"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="DOWNGRADE ▼"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#FFCC66"
        android:backgroundTint="#16213e"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/svDowngrade"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0f0f23"
        android:padding="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/llDowngrade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>
