<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connection mode:"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#888888"
        android:layout_marginBottom="4dp" />

    <RadioGroup
        android:id="@+id/rgMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="10dp">
        <RadioButton
            android:id="@+id/rbModeModem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modem tunnel (direct registrator)"
            android:textSize="13sp" />
        <RadioButton
            android:id="@+id/rbModeBalancer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Residential (via balancer)"
            android:textSize="13sp" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Share connection (host / port / key / id / dns):"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#888888"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">
        <Button
            android:id="@+id/btnImport"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="IMPORT"
            android:textSize="11sp"
            android:layout_marginEnd="4dp" />
        <Button
            android:id="@+id/btnExport"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="EXPORT"
            android:textSize="11sp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />
        <Button
            android:id="@+id/btnScanQr"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="SCAN QR"
            android:textSize="11sp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvScanQrHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="QR import auto-fills modem settings. Pick: live camera, image from gallery, or paste plain text from clipboard."
        android:textSize="10sp"
        android:textColor="#666666"
        android:layout_marginBottom="14dp" />

    <EditText
        android:id="@+id/etHost"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Host"
        android:inputType="text"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etPort"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Port"
        android:inputType="number"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etKey"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Agent Key"
        android:inputType="text"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etId"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Agent ID (modem UUID, e.g. KEY_PORT)"
        android:inputType="text"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etDns"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="DNS servers (empty = 1.1.1.1,8.8.8.8)"
        android:inputType="text"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <CheckBox
        android:id="@+id/cbSpeedBytes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show speed in MB/s (bytes) instead of Mb/s (bits)"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp"
        android:background="#33888888" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Analytics retention:"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#888888"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spRetention"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Older buckets are deleted on app launch. Storage grows ~1MB per active day."
        android:textSize="10sp"
        android:textColor="#666666"
        android:layout_marginBottom="6dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp"
        android:background="#33888888" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Engine:"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#888888"
        android:layout_marginBottom="4dp" />

    <RadioGroup
        android:id="@+id/rgEngine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <RadioButton
            android:id="@+id/rbEngineNative"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Native Kotlin (recommended)"
            android:textSize="13sp" />
        <RadioButton
            android:id="@+id/rbEngineBinary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Binary subprocess"
            android:textSize="13sp" />
    </RadioGroup>

    <!-- QUIC implementation picker was here. Removed from UI: the
         in-house QUIC stack is now the only path users can select.
         The kwik adapter (KwikQuicTransport) is still compiled in and
         reachable via the `quic_impl=kwik` start-intent extra for the
         rare manual override / regression-debug session, but the UI
         no longer exposes it. The library itself will be ripped out
         in a follow-up commit once the in-house path has more field
         hours; until then we keep the dead-but-compilable code as a
         safety net so we can A/B without an emergency rebuild. -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp"
        android:background="#33888888" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Network optimization:"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#888888"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spNetworkProfile"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvNetworkProfileHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tunes TCP socket / bridge buffers and QUIC pacer / UDP buffer / flow-control to the link's expected ceiling. Lower = lower latency on slower links; higher = full pipe on gigabit. Binary engine ignores this setting (uses fixed 100 Mbps)."
        android:textSize="10sp"
        android:textColor="#666666"
        android:layout_marginBottom="6dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp"
        android:background="#33888888" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="IP rotation guard:"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#888888"
        android:layout_marginBottom="4dp" />

    <CheckBox
        android:id="@+id/cbRotationLock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Block overlapping rotation requests"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="While a rotation is running, and for the cooldown below after it finishes, any new rotation request (remote REBOOT or the manual ↻ button) is ignored. Prevents two rotations from fighting over the radio. On by default."
        android:textSize="10sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cooldown after rotation (seconds):"
        android:textSize="11sp"
        android:textColor="#888888"
        android:layout_marginBottom="2dp" />

    <EditText
        android:id="@+id/etRotationCooldown"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="10"
        android:inputType="number"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Extra quiet window after a rotation completes before another is allowed. Default 10s. Set to 0 to only block during the rotation itself."
        android:textSize="10sp"
        android:textColor="#666666"
        android:layout_marginBottom="6dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp"
        android:background="#33888888" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="IP rotation fallbacks (root required):"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#888888"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Triggered only after the basic 2-step nuclear cycle fails to change the IP."
        android:textSize="10sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp" />

    <CheckBox
        android:id="@+id/cbApnSwap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="APN swap"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Toggles preferred APN to an alternate entry and back, forcing two fresh PDP contexts. Effective only if the SIM has 2+ APNs configured."
        android:textSize="10sp"
        android:textColor="#666666"
        android:layout_marginBottom="10dp" />

    <CheckBox
        android:id="@+id/cbImeiRotate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="IMEI rotation"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Invokes an identity-change command (needs a Magisk module installed) and re-attaches the radio under the new IMEI."
        android:textSize="10sp"
        android:textColor="#666666"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="IMEI rotation method:"
        android:textSize="11sp"
        android:textColor="#888888"
        android:layout_marginBottom="2dp" />

    <Spinner
        android:id="@+id/spImeiMethod"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etImeiCustomCmd"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Custom root command (e.g. magisk-imei --random)"
        android:inputType="text"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="resetprop: spoofs IMEI via MagiskHidePropsConfig (Android-level only — modem may still report real IMEI). magisk-imei: assumes the magisk-imei CLI is on PATH. Custom: runs whatever you type as root."
        android:textSize="10sp"
        android:textColor="#666666"
        android:layout_marginBottom="6dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp"
        android:background="#33888888" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Uplink routing:"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#888888"
        android:layout_marginBottom="4dp" />

    <CheckBox
        android:id="@+id/cbWifiReturn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Return traffic to client over Wi-Fi"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvWifiReturnHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bridges the agent↔registrator uplink over Wi-Fi while target dials still ride cellular (mobile exit IP preserved). Falls back to cellular transparently when Wi-Fi is gone — connection is never dropped, just the savings stop. Modem mode only."
        android:textSize="10sp"
        android:textColor="#666666"
        android:layout_marginBottom="6dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp"
        android:background="#33888888" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Auto-reconnect after reboot:"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#888888"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="When the agent is connected and the phone reboots, it comes back on its own — but only if the OS lets it. Grant the exemptions below so it isn't blocked."
        android:textSize="10sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp" />

    <!-- Lock-screen (Direct Boot) warning. Shown only when a secure lock
         screen is set; wired in SettingsActivity. -->
    <TextView
        android:id="@+id/tvAutostartLockWarn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text=""
        android:textSize="11sp"
        android:textColor="#e9a13b"
        android:padding="10dp"
        android:background="#22e9a13b"
        android:layout_marginBottom="8dp" />

    <!-- Live status readout (battery / OEM / lock / root), filled in code. -->
    <TextView
        android:id="@+id/tvAutostartStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textColor="#aaaaaa"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnBatteryOpt"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="DISABLE BATTERY OPTIMIZATION"
        android:textSize="11sp"
        android:layout_marginBottom="6dp" />

    <Button
        android:id="@+id/btnOemAutostart"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="OPEN AUTOSTART SETTINGS (OEM)"
        android:textSize="11sp"
        android:layout_marginBottom="6dp" />

    <Button
        android:id="@+id/btnRootAutostart"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="INSTALL ROOT AUTOSTART (GUARANTEED)"
        android:textSize="11sp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Root path (recommended for rooted fleet devices): installs a Magisk/KernelSU boot script that whitelists the app and starts the agent on every boot, bypassing OEM autostart blocking and Doze. Needs the connection to be configured first."
        android:textSize="10sp"
        android:textColor="#666666"
        android:layout_marginBottom="6dp" />

</LinearLayout>
</ScrollView>
