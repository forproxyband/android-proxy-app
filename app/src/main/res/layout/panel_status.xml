<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0f2a1f"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CONNECTED TO REGISTRATOR"
        android:textColor="#88ffaa"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/tvRegistrator"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#00ff41"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
        <TextView
            android:id="@+id/tvUptime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#88ffaa"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvActivity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#88ffaa"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:layout_marginTop="6dp" />

    <!-- Wi-Fi return relay indicator. Populated by MainActivity.refresh()
         from conn_info field 8 — empty (GONE) when the relay is disabled,
         green when the uplink is actually riding Wi-Fi, amber when the
         relay is up but currently fell back to cellular (no Wi-Fi held),
         red when the split-routing self-test rejected the relay. Holds
         the primary line (link speed / band / standard, or fallback /
         warning). -->
    <TextView
        android:id="@+id/tvUplinkVia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#88ffaa"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:layout_marginTop="2dp"
        android:visibility="gone" />

    <!-- Detailed two-IP block populated from wifi_info.json — only visible
         on a successful self-test. Multiline (max 3 short lines): cellular
         exit IP that targets see, Wi-Fi public IP that the registrator
         sees, and a verification line confirming the two are different. -->
    <TextView
        android:id="@+id/tvUplinkDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#88ffaa"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:layout_marginTop="2dp"
        android:visibility="gone" />

    <!-- Session-lifetime byte counters from conn_info fields 12-17.
         Format: "Session: Wi-Fi ↑12.4M ↓48.1M · Cell ↑8.2M ↓2.1M · saved 60.5M"
         The "saved" number is wifiUp+wifiDown (traffic that didn't ride
         cellular). Hidden when relay isn't running OR when there's nothing
         meaningful to show (all zero). -->
    <TextView
        android:id="@+id/tvSessionTraffic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#88ffaa"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:layout_marginTop="2dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvSwipeHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="‹ swipe for 24h graphs ›"
        android:textColor="#557766"
        android:textSize="9sp"
        android:fontFamily="monospace"
        android:layout_marginTop="4dp"
        android:layout_gravity="center_horizontal" />

</LinearLayout>
